# TLS configuration parser fixtures. Material paths are relative to this file.

*[TLS . Server]*
Label: "http/server"
certificate_chain_file: "../../network/tls-interop/server.pem"
signing_key_file: "../../network/tls-interop/server-key.pem"

*[TLS . Client]*
Label: "http/client"
trust_anchors_file: "../../network/tls-interop/ca.pem"
intermediate_certificates_file: "../../network/tls-interop/server.pem"

*[TLS . Server]*
Label: "http/combined"
certificate_chain_file: "../../network/tls-interop/server.pem"
signing_key_file: "../../network/tls-interop/server-key.pem"

*[TLS . Client]*
Label: "http/combined"
trust_anchors_file: "../../network/tls-interop/ca.pem"
