@version: "1.0"

---[ Run ]---------------------------------------------------------------------
Mode              : "profile"
Duration          : 1s
Threads           : 2
Corpus Limit      : 1 MiB

--*[ Scenario ]*---------------------------------------------------------------
Name              : "configuration-test"
Direction         : "read", "write"
File Type         : "binary", "utf8"
Methods           : "all"
File Size Min     : 1 KiB
File Size Max     : 2 KiB
Chunk Modes       : "fixed", "incrementing", "random"
Chunk Size Min    : 1
Chunk Size Max    : 257
Buffering         : "minimal-memory"
Back Buffer Limit : 8 KiB
Localities        : "hot", "rotating"
Weight            : 1

--*[ Scenario ]*---------------------------------------------------------------
Name              : "read-all-alias-test"
Direction         : "read"
File Type         : "all"
Methods           : "read-all"
File Size Min     : 1 KiB
File Size Max     : 1 KiB
Chunk Modes       : "fixed"
Chunk Size Min    : 1
Chunk Size Max    : 1 KiB
Buffering         : "minimal-memory"
Back Buffer Limit : 8 KiB
Localities        : "hot"
Weight            : 1
