# Configuration for the C++ anti-pattern scanner.

----[ Anti Patterns ]-------------------------------------------------------------------------------------------------
Source Directories           :
    * "src"
    * "cmake/tools/*/src"
    * "demos"
    * "test/unittest/src"
    * "test/profiling/*/src"
    * "test/profiling/*/test/src"
    * "test/constant-time/*/src"
    * "test/adapter/src"
    * "test/fuzzing/*/src"
    * "tool/src"
    * "tool/test/unittest/src"
File Suffixes                : ".cpp", ".hpp", ".tpp"

----[ Anti Patterns . Namespace Noise ]-------------------------------------------------------------------------------
Domains                      : "text", "unit", "err", "mem", "options", "path", "stream"
# Keep qualifications needed to disambiguate free functions from members and other domains.
Ignored Symbols              : "mem::secureErase", "text::join"

----[ Anti Patterns . Named Constant For Repeated Literals ]----------------------------------------------------------
Key Functions                :
    * "addOption"
    * "addRule"
    * "get"
    * "getOrThrow"
    * "set"
    * "setValue"
    * "value"
    * "valueOrThrow"
Key Function Prefixes        : "getText", "getInteger", "getFlag", "getStringList", "getValue"

----[ Anti Patterns . Missing Api Documentation ]---------------------------------------------------------------------
File Exemption Texts         : "UnitTest"
Declaration Exemption Texts  : "PrivateTag"

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "demos/**"
Rules                        :
    * "type_in_wrong_unit"
    * "implementation_in_wrong_unit"
    * "missing_api_documentation"
    * "oversized_nested_type"
    * "multiple_types_in_header"
    * "named_constant_for_repeated_literals"
Reason                       : """
    These files are included directly in documentation as complete teaching examples.
    Splitting demonstration types or implementations across units would fragment those excerpts.
    Full API documentation would duplicate the surrounding explanation and obscure the demonstrated operation.
    The same excerpt constraint applies to multiple header types and nested demonstration types.
    Repeated keys stay inline so each demonstration excerpt remains self-contained.
    """

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "demos/text/String/StdVsCore*"
Rules                        : "regular_string_literal"
Reason                       : """
    These examples compare standard-library string operations with Core operations, so replacing the standard
    forms would remove the subject of the comparison.
    """

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "test/unittest/**"
Rules                        :
    * "implementation_in_wrong_unit"
    * "static_cast_void"
    * "oversized_nested_type"
    * "oversized_file"
Reason                       : """
    Unit tests exercise low-level code and also illegal and invalid code to test the
    code base for failures. For this reason, unit tests use these constructs intentionally.
    """

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "test/unittest/src/**"
Rules                        : "regular_string_literal"
Reason                       : "The test framework requires std::string."

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "tool/test/unittest/src/ProjectFixture.hpp"
Rules                        : "regular_string_literal"
Reason                       :
    "The process test fixture passes narrow string arguments to the operating-system launcher."

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "test/fuzzing/**"
Rules                        : "static_cast_void"
Reason                       : """
    Fuzz entry points consume arbitrary inputs to exercise parser and verifier safety; a rejected input is not
    itself a fuzz failure.
    """

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "test/profiling/**"
Rules                        : "oversized_file"
Reason                       :
    "Profiling workloads keep each scenario, measurement loop, and result output together for review."

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "**/*Windows*"
Rules                        :
    * "implementation_in_wrong_unit"
    * "regular_string_literal"
    * "namespace_in_wrong_unit"
    * "multiple_namespaces"
Reason                       : """
    - Platform-neutral factories must select their Windows implementations in the native integration units.
    - Calls to native narrow-character interfaces require C string arguments rather than Core string objects.
    - Native adapter types and platform-neutral factories share the Windows integration units.
    - The factories retain their owning domain namespace even when the implementation lives in its impl directory.
    """

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "**/*Posix*"
Rules                        :
    * "implementation_in_wrong_unit"
    * "regular_string_literal"
    * "namespace_in_wrong_unit"
    * "multiple_namespaces"
Reason                       : """
    Platform-neutral factories must select their POSIX implementations in the native integration units.
    Calls to POSIX interfaces require narrow C string arguments rather than Core string objects.
    Native adapter types and platform-neutral factories share the POSIX integration units.
    The factories retain their owning domain namespace even when the implementation lives in its impl directory.
    """

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "**/*Traits.hpp"
Rules                        :
    * "static_only_class"
    * "multiple_types_in_header"
Reason                       : """
    Traits expose compile-time mappings through types rather than instances.
    The lexical scanner cannot establish that multiple traits form the coherent family defined by cpp_files.rst.
    """

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "**/*Types.hpp"
Rules                        : "multiple_types_in_header"
Reason                       : """
    The scanner cannot establish that these declarations form the coherent micro-type group defined by
    cpp_files.rst.
    """

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "**/*Tags.hpp"
Rules                        : "multiple_types_in_header"
Reason                       : """
    The scanner counts tag declarations as separate primary types, although cpp_files.rst defines related tags
    as one group.
    """

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "src/erbsland/core/Namespaces.hpp"
Rules                        :
    * "nested_namespace"
    * "namespace_in_wrong_unit"
    * "multiple_namespaces"
Reason                       : """
    This generated catalog declares all domain namespaces before their APIs are included.
    Its role requires namespaces from multiple source directories in one bootstrap header.
    """

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "src/erbsland/core/impl/MakeOneNamespace.hpp"
Rules                        :
    * "namespace_in_wrong_unit"
    * "forward_declaration"
    * "multiple_namespaces"
Reason                       : """
    This generated bootstrap must declare domain types before headers including Definitions.hpp define them.
    Their original namespaces must be retained so that the flattened exports refer to the same types.
    """

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "src/erbsland/cryptology/impl/algorithm/Sha2.hpp"
Rules                        : "multiple_types_in_header"
Reason                       : "The SHA-256 and SHA-64 implementations form one internal SHA-2 algorithm family."

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "src/erbsland/event/EventRegistry.hpp"
Rules                        : "nested_namespace"
Reason                       :
    "The public id namespace groups constants that are defined from and belong to EventRegistry."

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "src/erbsland/stream/StandardStreams.hpp"
Rules                        : "nested_namespace"
Reason                       :
    "The public io convenience namespace groups helpers around the enclosing standard-stream API."

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "src/erbsland/text/FormatAs.hpp"
Rules                        : "forward_declaration"
Reason                       : "This is a type trait that is used to implement the FormatAs functionality."

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "src/erbsland/text/impl/FloatConversion.cpp"
Rules                        : "regular_string_literal"
Reason                       : """
    The float conversion backend passes narrow views to parsing diagnostics and C strings to standard-library
    APIs.
    """

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "src/erbsland/text/impl/StaticStringPatternData.tpp"
Rules                        : "regular_string_literal"
Reason                       : """
    Constexpr pattern checks pass narrow views to requirePattern without constructing runtime String objects.
    """

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "src/erbsland/text/impl/StringConversionTools.hpp"
Rules                        : "static_only_class"
Reason                       : """
    The conversion functions need friend access to private string storage; a class provides that shared access
    boundary.
    """

---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "src/erbsland/text/u*/U*", "src/erbsland/text/u*/impl/*"
Rules                        : "regular_string_literal"
Reason                       :
    "Low-level text error paths pass narrow messages to avoid depending on the String layer they implement."


---*[ Anti Patterns . Exception ]*------------------------------------------------------------------------------------
Path                         : "test/unittest/src/text/FormatAsTest.cpp"
Rules                        : "multiple_namespaces"
Reason                       :
    "The test-local value types and their FormatAs specialization must use their respective owning namespaces."
