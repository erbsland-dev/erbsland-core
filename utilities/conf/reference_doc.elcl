# Configuration file for the "reference_doc.py" script.
--[ Main ]------------------------------------------------------------------------------------------------------------
# Directory with public library C++ sources. All paths are relative to the project root.
Source Directory            : "src/erbsland"

# Directory with Sphinx reference pages. All paths are relative to the project root.
Reference Directory         : "doc/reference"

# Directory names skipped while scanning headers.
Excluded Directory Names    :
    * "impl"

# Header names skipped while scanning.
Excluded Header Names       :
    * "all.hpp"
    * "fwd.hpp"
    * "IntegerTraits.hpp"
    * "IntegerTypes.hpp"
    * "AnyIntegerTypes.hpp"

# Individual public headers with hand-maintained reference pages are not scanned.
Excluded Header Globs       :
    * "core/ApplicationErrorContext.hpp"
    * "core/Definitions.hpp"
    * "core/MakeOneNamespace.hpp"
    * "core/Namespaces.hpp"
    * "resource/ResourceStorageRegistration.hpp"
    * "system/MakeOneNamespace.hpp"

# Reference pages maintained entirely by hand and never removed as orphans.
Manual Reference Pages      :
    * "core/application_error_context.rst"
    * "core/definitions.rst"
    * "core/make_one_namespace.rst"
    * "core/namespaces.rst"

# Exclude .hpp files whose file name contains "_".
Exclude Underscore Headers  : Yes

# Load the domain-specific reference groups.
@include: "reference_doc/*.elcl"
