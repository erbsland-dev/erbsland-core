cmake_minimum_required(VERSION 3.28)
set(test_directory "${BUILD_DIRECTORY}/test/cmake/display-text-installed")
set(prefix "${test_directory}/install")
set(fixture "${test_directory}/source")
set(consumer "${test_directory}/build")
file(REMOVE_RECURSE "${test_directory}")
file(MAKE_DIRECTORY "${fixture}")
foreach(name IN ITEMS CMakeLists.txt src Words.elcl Extra.elcl Empty.elcl)
    file(COPY "${FIXTURE_DIRECTORY}/${name}" DESTINATION "${fixture}")
endforeach()

function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()

function(build)
    run("${CMAKE_COMMAND}" --build "${consumer}" --config Debug)
    set(last_output "${last_output}" PARENT_SCOPE)
endfunction()

run("${CMAKE_COMMAND}" --install "${BUILD_DIRECTORY}" --prefix "${prefix}" --config "${CONFIGURATION}")
run("${CMAKE_COMMAND}" -S "${fixture}" -B "${consumer}" -G "${GENERATOR}"
        "-DCMAKE_PREFIX_PATH=${prefix}" -DCMAKE_BUILD_TYPE=Debug)
# Generated files need not exist during configure.
build()
if(WIN32)
    set(suffix ".exe")
else()
    set(suffix "")
endif()
set(executable "${consumer}/display-text-consumer${suffix}")
if(NOT EXISTS "${executable}")
    set(executable "${consumer}/Debug/display-text-consumer${suffix}")
endif()
run("${executable}")
set(header "${consumer}/generated/include/Labels.hpp")
set(source "${consumer}/generated/source/Labels.cpp")
file(TIMESTAMP "${header}" header_time "%s.%f")
file(TIMESTAMP "${source}" source_time "%s.%f")
build()
if(last_output MATCHES "Compiling display texts")
    message(FATAL_ERROR "An unchanged build reran the catalog compiler.")
endif()
# Comment-only changes rerun generation without touching generated files.
file(APPEND "${fixture}/Words.elcl" "\n# comment-only update\n")
build()
file(TIMESTAMP "${header}" unchanged_header_time "%s.%f")
file(TIMESTAMP "${source}" unchanged_source_time "%s.%f")
if(NOT header_time STREQUAL unchanged_header_time OR NOT source_time STREQUAL unchanged_source_time)
    message(FATAL_ERROR "Comment-only input changes touched generated files.")
endif()
file(READ "${header}" header_text)
string(REGEX REPLACE "Copyright \\(c\\) [0-9]+" "Copyright (c) 1999" header_text "${header_text}")
file(WRITE "${header}" "${header_text}")
file(TIMESTAMP "${header}" copyright_time "%s.%f")
file(APPEND "${fixture}/Words.elcl" "# force copyright comparison\n")
build()
file(TIMESTAMP "${header}" copyright_after "%s.%f")
if(NOT copyright_time STREQUAL copyright_after)
    message(FATAL_ERROR "Copyright-only changes were overwritten.")
endif()
# Missing generated files are recovered on the next build.
file(REMOVE "${header}" "${source}")
build()
run("${executable}")
# Changes to generation options must rerun the compiler.
file(READ "${fixture}/src/main.cpp" main_text)
string(REPLACE "sample::wording::Labels" "sample::renamed::RenamedLabels" main_text "${main_text}")
file(WRITE "${fixture}/src/main.cpp" "${main_text}")
run("${CMAKE_COMMAND}" -S "${fixture}" -B "${consumer}" -DDISPLAY_TEXT_RENAMED=ON)
build()
run("${executable}")
# All generated files belong to the build tree and are cleanable.
if(EXISTS "${fixture}/Extra.hpp" OR EXISTS "${fixture}/generated")
    message(FATAL_ERROR "The macro wrote generated files into the source tree.")
endif()
run("${CMAKE_COMMAND}" --build "${consumer}" --config Debug --target clean)
if(EXISTS "${header}" OR EXISTS "${source}" OR EXISTS "${consumer}/Extra.hpp")
    message(FATAL_ERROR "CMake clean retained generated catalog files.")
endif()
build()
run("${executable}")
# Changed content must reach a previously built consumer.
file(READ "${fixture}/Words.elcl" input_text)
string(REPLACE "Custom Usage" "Updated Usage" input_text "${input_text}")
file(WRITE "${fixture}/Words.elcl" "${input_text}")
file(READ "${fixture}/src/main.cpp" main_text)
string(REPLACE "Custom Usage" "Updated Usage" main_text "${main_text}")
file(WRITE "${fixture}/src/main.cpp" "${main_text}")
build()
run("${executable}")
set(host_compiler "${prefix}/bin/erbsland-core-display-text-compiler${suffix}")
# The standalone executable also derives sibling paths while preserving earlier suffixes.
file(WRITE "${fixture}/Standalone.Words.elcl" "[Root]\nWord = \"standalone\"\n")
run("${host_compiler}" --input "${fixture}/Standalone.Words.elcl" --class StandaloneWords)
if(NOT EXISTS "${fixture}/Standalone.Words.hpp" OR NOT EXISTS "${fixture}/Standalone.Words.cpp")
    message(FATAL_ERROR "Standalone compiler did not derive sibling output paths.")
endif()
foreach(error_case IN ITEMS cross-missing missing-host invalid-class duplicate outside-build)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${test_directory}/${error_case}"
            -G "${GENERATOR}" "-DCMAKE_PREFIX_PATH=${prefix}" "-DDISPLAY_TEXT_CASE=${error_case}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(result EQUAL 0)
        message(FATAL_ERROR "Expected CMake rejection for ${error_case}.")
    endif()
endforeach()
run("${CMAKE_COMMAND}" -S "${fixture}" -B "${consumer}" "-DCMAKE_PREFIX_PATH=${prefix}"
        -DDISPLAY_TEXT_CASE=cross-explicit "-DHOST_COMPILER=${host_compiler}")
build()
run("${executable}")
