@version: "1.0"

---[ Run ]---------------------------------------------------------------------
Mode                : "benchmark"
Duration            : 60s
Threads             : 1
Warmup Samples      : 0
Samples             : 1
Minimum Sample Time : 100us
Memory Limit        : 8 MiB
Progress Interval   : 5s

--*[ Scenario ]*---------------------------------------------------------------
Name                : "coverage"
Types               : "all"
Use Cases           : "all"
Variants            : "all"
Size Modes          : "fixed"
Size Min            : 64
Size Max            : 64
Operand Size Min    : 16
Operand Size Max    : 16
Sensitive Modes     : "normal", "sensitive"
Weight              : 1
