@version: "1.0"

---[ Run ]---------------------------------------------------------------------
Mode                : "benchmark"
Suite               : "snapshot"
Duration            : 1ns
Threads             : 1
Warmup Samples      : 0
Samples             : 1
Minimum Sample Time : 1ms
Memory Limit        : 8 MiB
Progress Interval   : 1s
Regex Timeout       : 1s
Workspace           : ""
Keep Files          : no
