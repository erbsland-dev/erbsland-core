# Configuration file for the "update_includes.py" script.
@include: "header.elcl"

--[ Main ]------------------------------------------------------------------------------------------------------------
# Directory basenames to skip while scanning "src/erbsland".
# A header is ignored if one of its parent directories has a matching name.
Excluded Directories    :
    * "impl"             # Implementation files
    * "attribute"        # conf/vf/builder/attribute files are included via `Attributes.hpp`
    * "constraint"       # conf/vf/builder/constraint files are included via `Constraint.hpp`

# Source-relative public headers to skip while scanning "src/erbsland".
# Use this for platform-specific public headers that are added through
# conditional CMake target_sources blocks.
Excluded Headers        :
    * "system/WindowsErrorContext.hpp"

# Source-relative public headers that get an individual include wrapper but are
# omitted from generated all.hpp headers. Keep opt-in interoperability adapters
# out of regular builds and include them explicitly where they are needed.
Excluded From All Headers :
    * "bgeo/StdFormat.hpp"
    * "conf/StdFormat.hpp"
    * "cryptology/StdFormat.hpp"
    * "re/StdFormat.hpp"
    * "text/StdFormat.hpp"
    * "time/StdFormat.hpp"
    * "unit/StdFormat.hpp"
    * "resource/ResourceStorageRegistration.hpp"

# Source-relative public headers that remain available in their original
# include directory but are not additionally exposed in the folded parent.
# Use this to opt individual headers out of folding:
# Excluded From Parent Folding :
#     * "domain/Header.hpp"

# When enabled, every scanned source header also gets a wrapper directly below
# "include/erbsland" using only its file name, in addition to the wrapper that
# mirrors its source subdirectory.
Create Global Includes  : No

# Directory basenames whose headers shall also be exposed in their parent
# directory. The folded headers are added to the parent's generated "all.hpp",
# and matching public wrappers are created in the parent include directory.
# Headers with the same name from multiple folded directories are merged into
# one forwarding wrapper. A real header with that name in the parent remains
# a conflict.
Fold into Parent        :
    * "bgeo"
    * "core"
    * "err"
    * "event"
    * "math"
    * "mem"
    * "network"
    * "options"
    * "path"
    * "random"
    * "stream"
    * "text"
    * "time"
    * "unit"
    * "util"

# Limits where generated source "all.hpp" files and flattened public
# "all_<path>.hpp" wrappers are created. If empty, all scanned directories and
# folded parent directories are considered. If set, only directories below this
# relative source path are considered, and the flattened wrappers are written
# below the same include path. The include root itself is exposed as "all.hpp"
# and does not get a flattened "all_..." alias.
Create All Base Dir     : ""
