# Shared generated-file header configuration.
--[ Header ]----------------------------------------------------------------------------------------------------------
# Copyright blocks. The placeholder "{year}" is replaced with the current year.
hpp_copyright:
    """
    // Copyright © {year} Tobias Erbsland - https://erbsland.dev
    // SPDX-License-Identifier: Apache-2.0
    """

cpp_copyright:
    """
    // Copyright © {year} Tobias Erbsland - https://erbsland.dev
    // SPDX-License-Identifier: Apache-2.0
    """

py_copyright:
    """
    # Copyright © {year} Tobias Erbsland - https://erbsland.dev
    # SPDX-License-Identifier: Apache-2.0
    """

# Compact header for generated public include wrappers.
include_copyright:
    """
    #pragma once
    """

# Generated-file warnings. The placeholder "{tool}" is replaced with the generating tool.
cpp_warning:
    """
    // !!! THIS IS A GENERATED FILE - DO NOT EDIT MANUALLY !!!
    // This file was generated by the "{tool}" script.
    """

py_warning:
    """
    # !!! THIS IS A GENERATED FILE - DO NOT EDIT MANUALLY !!!
    # This file was generated by the "{tool}" script.
    """
