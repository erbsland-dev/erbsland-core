# Reference-document groups for the cterm domain.

---*[ Doc Update Reference . Reference Groups ]*----------------------------------------------------------------------
Page                         : "cterm/terminal.rst"
Title                        : "Terminal Interface"
Header Globs                 :
    * "cterm/*.hpp"
Excluded Header Globs        :
    * "cterm/ReadLine*.hpp"
    * "cterm/ReadSecret*.hpp"
    * "cterm/TerminalDocument*.hpp"
    * "cterm/TerminalEmulation*.hpp"
    * "cterm/BufferRenderOptions.hpp"
    * "cterm/RenderFormat.hpp"

---*[ Doc Update Reference . Reference Groups ]*----------------------------------------------------------------------
Page                         : "cterm/read_line.rst"
Title                        : "Interactive Line Editor"
Header Globs                 :
    * "cterm/ReadLine*.hpp"
    * "cterm/ReadSecret*.hpp"

---*[ Doc Update Reference . Reference Groups ]*----------------------------------------------------------------------
Page                         : "cterm/terminal_document_renderer.rst"
Title                        : "Terminal Document Renderer"
Header Globs                 :
    * "cterm/TerminalDocument*.hpp"

---*[ Doc Update Reference . Reference Groups ]*----------------------------------------------------------------------
Page                         : "cterm/terminal_emulation.rst"
Title                        : "Terminal Emulation"
Header Globs                 : "cterm/TerminalEmulation*.hpp"

---*[ Doc Update Reference . Reference Groups ]*----------------------------------------------------------------------
Page                         : "cterm/buffer_rendering.rst"
Title                        : "Buffer Rendering"
Headers                      : "cterm/BufferRenderOptions.hpp", "cterm/RenderFormat.hpp"
